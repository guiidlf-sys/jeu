		waves = {
			{ mobs = { { id = "calamite", count = 4 } } },
			{ mobs = { { id = "calamite", count = 6 }, { id = "spectre", count = 6 } } },
			{ mobs = { { id = "roi_maudit", count = 1 }, { id = "calamite", count = 3 } } },
		},

		BackgroundTransparency = 1,
		ZIndex = 32,
		Parent = window,
	})

	Theme.create("TextLabel", {
		Position = UDim2.fromOffset(20, 0),
		Size = UDim2.new(1, -80, 1, 0),
		BackgroundTransparency = 1,
		Font = Theme.TitleFont,
		Text = titleText,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Palette.text,
